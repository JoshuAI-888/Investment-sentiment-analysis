      "expected": { "eligibility": "ok", "exact": "60", "display": "60", "abstention": null, "warnings": [] }
    },
    {
      "name": "decrease",
      "inputs": { "mentions_now": "40", "mentions_prior": "90" },
      "expected": { "eligibility": "ok", "exact": "-50", "display": "-50", "abstention": null, "warnings": [] }
    },
    {
      "name": "no_change",
      "inputs": { "mentions_now": "90", "mentions_prior": "90" },
      "expected": { "eligibility": "ok", "exact": "0", "display": "0", "abstention": null, "warnings": [] }
    },
    {
      "name": "from_zero",
      "inputs": { "mentions_now": "12", "mentions_prior": "0" },
      "expected": { "eligibility": "ok", "exact": "12", "display": "12", "abstention": null, "warnings": [] }
    }
  ]
}
